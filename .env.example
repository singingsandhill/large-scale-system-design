# 로컬 전용 환경 설정 예시. 복사해서 사용한다.
#
#   cp .env.example .env
#
# .env 는 저장소 "루트"에 두고, git 에는 절대 커밋하지 않는다(.gitignore 처리됨).
# application.yaml 의 spring.config.import 가 이 파일을 읽는다.
#
# ── 형식 주의 ──────────────────────────────────────────────────────────────
# 이 파일은 shell 이 아니라 java.util.Properties 규칙으로 파싱된다.
#   - export 를 붙이지 말 것.   export FOO=bar → 키가 'export', 값이 'FOO=bar' 가 된다.
#   - 따옴표를 쓰지 말 것.      FOO="bar"      → 값에 따옴표가 그대로 포함된다.
#   - '#' 과 '!' 로 시작하는 줄은 주석이다.
#   - 값에 한글을 쓰지 말 것(ISO-8859-1 로 읽힌다). 꼭 필요하면 application.yaml 의
#     import 를 "optional:file:.env[extension=.properties][encoding=utf-8]" 로 바꾼다.
#
# ── 여기에 넣으면 안 되는 키 ───────────────────────────────────────────────
#   spring.profiles                → 기동 시 예외 발생 (spring.config.activate.on-profile 로 대체됨)
#   spring.profiles.active         → 동작은 하지만 프로파일 활성화가 눈에 보이지 않아 금지
#   spring.config.name / location  → 너무 이른 단계에서 읽히므로 여기 적으면 조용히 무시된다
#                                    (필요하면 실제 환경변수나 --옵션으로 전달)
#
# ── 규칙 ───────────────────────────────────────────────────────────────────
# 새 설정은 application.yaml 에 ${ENV_NAME:default} 로 먼저 선언하고,
# 그 다음 이 파일에 예시 값을 추가한다. 실제 비밀값은 절대 적지 않는다.
# ---------------------------------------------------------------------------

# 애플리케이션 포트
SERVER_PORT=8080

# H2 웹 콘솔 (http://localhost:8080/h2-console). 로컬에서만 true.
H2_CONSOLE=false
